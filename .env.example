# Copy this file to .env (and to server/.env, workers/.env as needed) and fill in real values.
# Never commit the actual .env file.

# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGO_URI=mongodb://localhost:27017/codebase-assistant

# --- Queue / cache ---
REDIS_URL=redis://localhost:6379

# --- Local vector store + embedding + LLM (all free, run via docker-compose) ---
VECTOR_SERVICE_URL=http://localhost:8001
EMBEDDING_SERVICE_URL=http://localhost:8002
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
